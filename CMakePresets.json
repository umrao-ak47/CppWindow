{
  "version": 2,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "ninja-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-presets/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "dev",
      "displayName": "Dev",
      "description": "Debug build with examples and tests.",
      "inherits": "ninja-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CPPWINDOW_BUILD_EXAMPLES": "ON",
        "CPPWINDOW_BUILD_TESTS": "ON",
        "CPPWINDOW_BUILD_DOCS": "OFF"
      }
    },
    {
      "name": "sanitizers",
      "displayName": "Sanitizers",
      "description": "Debug build with AddressSanitizer and UndefinedBehaviorSanitizer.",
      "inherits": "ninja-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CPPWINDOW_ENABLE_SANITIZERS": "ON",
        "CPPWINDOW_BUILD_EXAMPLES": "ON",
        "CPPWINDOW_BUILD_TESTS": "ON",
        "CPPWINDOW_BUILD_DOCS": "OFF"
      }
    },
    {
      "name": "imgui",
      "displayName": "ImGui",
      "description": "Debug build with optional Dear ImGui core and platform targets.",
      "inherits": "ninja-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CPPWINDOW_BUILD_IMGUI": "ON",
        "CPPWINDOW_BUILD_EXAMPLES": "ON",
        "CPPWINDOW_BUILD_TESTS": "ON",
        "CPPWINDOW_BUILD_DOCS": "OFF"
      }
    },
    {
      "name": "ci-release",
      "displayName": "CI Release",
      "description": "Release CI build with examples and tests.",
      "inherits": "ninja-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CPPWINDOW_BUILD_EXAMPLES": "ON",
        "CPPWINDOW_BUILD_TESTS": "ON",
        "CPPWINDOW_BUILD_DOCS": "OFF"
      }
    },
    {
      "name": "ci-imgui",
      "displayName": "CI ImGui",
      "description": "Release CI build with optional Dear ImGui targets.",
      "inherits": "ci-release",
      "cacheVariables": {
        "CPPWINDOW_BUILD_IMGUI": "ON"
      }
    },
    {
      "name": "ci-windows",
      "displayName": "CI Windows",
      "description": "Visual Studio release CI build with examples and tests.",
      "generator": "Visual Studio 17 2022",
      "binaryDir": "${sourceDir}/build-presets/ci-windows",
      "cacheVariables": {
        "CPPWINDOW_BUILD_EXAMPLES": "ON",
        "CPPWINDOW_BUILD_TESTS": "ON",
        "CPPWINDOW_BUILD_DOCS": "OFF"
      }
    },
    {
      "name": "install",
      "displayName": "Install",
      "description": "Release install/package validation build.",
      "inherits": "ninja-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/install",
        "CPPWINDOW_INSTALL": "ON",
        "CPPWINDOW_BUILD_EXAMPLES": "OFF",
        "CPPWINDOW_BUILD_TESTS": "OFF",
        "CPPWINDOW_BUILD_DOCS": "OFF"
      }
    },
    {
      "name": "install-imgui",
      "displayName": "Install ImGui",
      "description": "Release install/package validation build with optional Dear ImGui targets.",
      "inherits": "install",
      "cacheVariables": {
        "CPPWINDOW_BUILD_IMGUI": "ON"
      }
    },
    {
      "name": "docs",
      "displayName": "Docs",
      "description": "Docs-only build. This does not configure GLFW.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-presets/docs",
      "cacheVariables": {
        "CPPWINDOW_BUILD_DOCS": "ON",
        "CPPWINDOW_BUILD_EXAMPLES": "OFF",
        "CPPWINDOW_BUILD_TESTS": "OFF"
      }
    },
    {
      "name": "multi",
      "displayName": "Multi-Config",
      "description": "Ninja Multi-Config build for Debug and Release from one build tree.",
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build-presets/multi",
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "Debug;Release",
        "CPPWINDOW_BUILD_EXAMPLES": "ON",
        "CPPWINDOW_BUILD_TESTS": "ON",
        "CPPWINDOW_BUILD_DOCS": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "dev",
      "configurePreset": "dev"
    },
    {
      "name": "sanitizers",
      "configurePreset": "sanitizers"
    },
    {
      "name": "imgui",
      "configurePreset": "imgui"
    },
    {
      "name": "ci-release",
      "configurePreset": "ci-release"
    },
    {
      "name": "ci-imgui",
      "configurePreset": "ci-imgui"
    },
    {
      "name": "ci-windows-release",
      "configurePreset": "ci-windows",
      "configuration": "Release"
    },
    {
      "name": "docs",
      "configurePreset": "docs",
      "targets": [
        "cppwindow_docs"
      ]
    },
    {
      "name": "install",
      "configurePreset": "install",
      "targets": [
        "install"
      ]
    },
    {
      "name": "install-imgui",
      "configurePreset": "install-imgui",
      "targets": [
        "install"
      ]
    },
    {
      "name": "multi-debug",
      "configurePreset": "multi",
      "configuration": "Debug"
    },
    {
      "name": "multi-release",
      "configurePreset": "multi",
      "configuration": "Release"
    }
  ],
  "testPresets": [
    {
      "name": "dev",
      "configurePreset": "dev",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "sanitizers",
      "configurePreset": "sanitizers",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "timeout": 120
      }
    },
    {
      "name": "imgui",
      "configurePreset": "imgui",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "ci-release",
      "configurePreset": "ci-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "ci-imgui",
      "configurePreset": "ci-imgui",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "ci-windows-release",
      "configurePreset": "ci-windows",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "multi-debug",
      "configurePreset": "multi",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "multi-release",
      "configurePreset": "multi",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
