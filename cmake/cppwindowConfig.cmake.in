@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

find_dependency(glfw3 @CPPWINDOW_REQUIRED_GLFW_VERSION@)

include("${CMAKE_CURRENT_LIST_DIR}/cppwindowTargets.cmake")

foreach(_cppwindow_component IN LISTS cppwindow_FIND_COMPONENTS)
    if(_cppwindow_component STREQUAL "imgui")
        if(TARGET cppwindow::imgui)
            set(cppwindow_${_cppwindow_component}_FOUND TRUE)
        else()
            set(cppwindow_${_cppwindow_component}_FOUND FALSE)
        endif()
    elseif(_cppwindow_component STREQUAL "dear_imgui")
        if(TARGET cppwindow::dear_imgui)
            set(cppwindow_${_cppwindow_component}_FOUND TRUE)
        else()
            set(cppwindow_${_cppwindow_component}_FOUND FALSE)
        endif()
    else()
        set(cppwindow_${_cppwindow_component}_FOUND FALSE)
    endif()
endforeach()

check_required_components(cppwindow)
